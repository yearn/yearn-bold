# Ethereum mainnet RPC used by the browser. Replace with your preferred provider.
# NEXT_PUBLIC_ values are embedded in the client bundle and must not contain secrets.
NEXT_PUBLIC_RPC_URL=https://ethereum-rpc.publicnode.com

# Optional. Create a project ID at https://dashboard.reown.com.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=replace-with-your-project-id

# Optional. Without a key, Enso quotes use Yearn's public API proxy.
# ENSO_API_KEY=replace-with-your-enso-api-key
